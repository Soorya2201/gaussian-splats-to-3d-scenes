# ---- Remote text model (OpenAI-compatible: NVIDIA NIM or HF Inference) ----
# Paste your key below. Examples:
#   NVIDIA NIM:  https://integrate.api.nvidia.com/v1  + meta/llama-3.1-8b-instruct
#   HF Router:   https://router.huggingface.co/v1     + a 7B instruct model
TEXT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
TEXT_LLM_API_KEY=CHANGE_ME
TEXT_LLM_MODEL=meta/llama-3.1-8b-instruct

# ---- Local vision model (Ollama on this Mac; OpenAI-compatible endpoint) ----
# vLLM can't run on macOS (needs CUDA); we use Ollama's OpenAI-compatible API.
VISION_BASE_URL=http://localhost:11434/v1
VISION_API_KEY=ollama
VISION_MODEL=qwen2.5vl:3b

# ---- Server ----
FRONTEND_ORIGIN=http://localhost:5173
